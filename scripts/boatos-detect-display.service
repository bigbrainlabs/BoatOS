[Unit]
Description=BoatOS Touchscreen Detection (headless-safe Helm gate)
DefaultDependencies=no
Before=lightdm.service
After=local-fs.target systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/boatos-detect-display.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
